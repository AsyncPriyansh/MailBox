# Nginx reverse proxy configuration for Mailbox API on Hostinger VPS
# Place in /etc/nginx/sites-available/mailbox-api and symlink to /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name api.yourdomain.com; # Replace with your subdomain or VPS IP

    location / {
        proxy_pass http://127.0.0.1:5051;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 90;
    }
}
